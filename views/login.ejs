<!doctype html>
<html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Sign in — PulseReach</title><link rel="stylesheet" href="/css/app.css?v=23"></head>
<body class="auth-page organiser-auth">
<main class="auth-layout">
  <section class="auth-image-panel"><img src="/images/pulsereach-organiser.jpg" alt="Blood donation camp"><div class="auth-image-shade"></div><a class="auth-image-brand" href="/"><span class="brand-mark"><img src="/images/pulsereach-logo.png" alt="PulseReach logo"></span> PulseReach</a><div class="auth-image-kicker">ORGANISER ACCESS</div></section>
  <section class="auth-content"><div class="auth-card-refresh"><div class="eyebrow">ORGANISER ACCESS</div><h1>Welcome back.</h1><p class="lead">Sign in to manage your blood donation drives and mobilisation workspace.</p><% if (error) { %><div class="form-error"><%= error %></div><% } %><form method="post" action="/login"><input type="hidden" name="next" value="<%= next %>"><label>Email address<input type="email" name="email" autocomplete="email" required placeholder="you@example.com"></label><label>Password<input type="password" name="password" autocomplete="current-password" required placeholder="Enter your password"></label><button class="btn btn-primary full-btn">Sign in →</button></form><small>New organiser? <a class="text-link" href="/register-organizer">Create an account</a></small></div></section>
</main><script src="/js/pulsereach-assistant.js?v=1"></script></body></html>
