<!doctype html>
<html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Donor Dashboard — PulseReach</title><link rel="stylesheet" href="/css/app.css?v=21"></head>
<body class="register-page donor-dashboard-page">
<main class="donor-dashboard-shell">
<header class="donor-topbar"><div class="register-brand"><span class="brand-mark">♥</span> PulseReach</div><div class="donor-top-actions"><span class="donor-welcome">Hi, <b><%= donor.name %></b></span><form method="post" action="/donor/logout"><button class="btn btn-ghost">Sign out</button></form></div></header>
<section class="donor-hero"><div><div class="eyebrow">MY DONOR DASHBOARD</div><h1>Your donor journey, in one place.</h1><p class="lead">Track your registrations, donation history, e-certificates and future-drive communication.</p></div><div class="blood-chip"><span>Blood group</span><strong><%= donor.bloodGroup %></strong></div></section>
<% const paused = donor.notificationPausedUntil && new Date(donor.notificationPausedUntil) > new Date(); %>
<div class="donor-stat-grid"><div class="donor-stat"><span>Donations</span><strong><%= donations.length %></strong></div><div class="donor-stat"><span>Drive registrations</span><strong><%= registrations.length %></strong></div><div class="donor-stat"><span>Last donation</span><strong><%= donor.lastDonationDate ? new Date(donor.lastDonationDate).toLocaleDateString('en-IN') : '—' %></strong></div><div class="donor-stat"><span>Notifications</span><strong><%= paused ? 'Paused' : 'Active' %></strong></div></div>
<% if (paused) { %><div class="info-note donor-pause"><b>Future-drive notifications are paused until <%= new Date(donor.notificationPausedUntil).toLocaleDateString('en-IN',{day:'2-digit',month:'long',year:'numeric'}) %>.</b><span>PulseReach uses this as a communication setting after a recorded donation. Medical eligibility and screening are handled by authorised professionals.</span></div><% } else { %><div class="success-note"><b>Future-drive notifications are active.</b><span>You can receive future drive updates according to your communication consent.</span></div><% } %>
<div class="donor-grid">
<section class="dashboard-card"><div class="section-head"><div><div class="eyebrow">MY PROFILE</div><h2>Donor information</h2></div></div><div class="profile-grid"><div><span>Name</span><b><%= donor.name %></b></div><div><span>Mobile</span><b><%= donor.phone %></b></div><div><span>Gender</span><b><%= donor.gender %></b></div><div><span>Blood group</span><b><%= donor.bloodGroup %></b></div><div><span>Language</span><b><%= donor.preferredLanguage %></b></div><div><span>Future-drive consent</span><b><%= donor.futureDriveConsent ? 'Enabled' : 'Disabled' %></b></div></div></section>
<section class="dashboard-card"><div class="section-head"><div><div class="eyebrow">FIND A DRIVE</div><h2>Upcoming drives</h2></div></div><% if (!activeDrives.length) { %><div class="empty-state"><b>No upcoming drives.</b><p>Check back when a new drive is announced.</p></div><% } else { %><div class="drive-list"><% activeDrives.slice(0,4).forEach(d => { const already = registeredDriveIds.includes(String(d._id)); %><article class="drive-row"><div><b><%= d.name %></b><span><%= new Date(d.date).toLocaleDateString('en-IN',{day:'2-digit',month:'short',year:'numeric'}) %> · <%= d.venue %></span></div><% if (already) { %><span class="status-pill">Registered</span><% } else { %><a class="btn btn-primary" href="/register/<%= d._id %>">Register →</a><% } %></article><% }) %></div><% } %></section>
</div>
<section class="dashboard-card"><div class="section-head"><div><div class="eyebrow">MY REGISTRATIONS</div><h2>Blood donation drives</h2></div></div><% if (!registrations.length) { %><div class="empty-state"><b>No registrations yet.</b><p>Your drive registrations will appear here.</p></div><% } else { %><div class="history-list"><% registrations.forEach(r => { %><article class="history-item"><div><b><%= r.driveId?.name || 'Blood donation drive' %></b><span><%= r.driveId?.venue || 'Venue unavailable' %> · Registered <%= new Date(r.createdAt).toLocaleDateString('en-IN',{day:'2-digit',month:'short',year:'numeric'}) %></span></div><div class="history-actions"><span class="status-pill"><%= r.confirmationStatus %></span><a class="btn btn-ghost" href="/registration/<%= r.registrationCode %>">View</a></div></article><% }) %></div><% } %></section>
<section class="dashboard-card notifications-card"><div class="section-head"><div><div class="eyebrow">NOTIFICATIONS</div><h2>Drive communications</h2></div><span class="notification-count"><%= notifications.filter(n => !n.readAt).length %> unread</span></div>
<p class="section-muted">Only communications covered by your drive-level consent appear here. Opening a notification records an engagement signal for the organiser's turnout prediction.</p>
<% if (!notifications.length) { %><div class="empty-state"><b>No notifications yet.</b><p>When you consent to communication for a registered drive, relevant updates will appear here.</p></div><% } else { %><div class="notification-list"><% notifications.forEach(n => { const unread = !n.readAt; %><article class="notification-item <%= unread ? 'unread' : 'read' %>"><div class="notification-icon">✦</div><div class="notification-content"><div class="notification-meta"><span><%= n.stage %></span><span><%= n.driveId?.name || 'PulseReach drive' %></span><span><%= new Date(n.createdAt).toLocaleString('en-IN') %></span></div><p><%= n.message %></p><% if (unread) { %><form method="post" action="/donor/notifications/<%= n._id %>/read"><input type="hidden" name="participantId" value="<%= n.participantId %>"><button class="btn btn-primary btn-small" type="submit">Mark as read</button></form><% } else { %><span class="read-label">✓ Read · engagement recorded</span><% } %></div></article><% }) %></div><% } %></section>
<section class="dashboard-card"><div class="section-head"><div><div class="eyebrow">DONATION HISTORY</div><h2>Previous donations & e-certificates</h2></div></div><% if (!donations.length) { %><div class="empty-state"><b>No completed donations recorded yet.</b><p>Once an organiser records your completed donation, the date, location and e-certificate will appear here.</p></div><% } else { %><div class="history-list"><% donations.forEach(d => { %><article class="history-item"><div><b><%= new Date(d.donationDate).toLocaleDateString('en-IN',{day:'2-digit',month:'short',year:'numeric'}) %></b><span><%= d.location %> · <%= d.driveId?.name || 'PulseReach drive' %></span></div><a class="btn btn-primary" href="/certificates/<%= d.certificateCode %>" target="_blank">View e-certificate ↗</a></article><% }) %></div><% } %></section>
<footer class="donor-footer">PulseReach handles donor mobilisation and communication. Medical screening, eligibility and donation decisions remain with authorised professionals.</footer>
</main><script src="/js/pulsereach-assistant.js?v=1"></script></body></html>
