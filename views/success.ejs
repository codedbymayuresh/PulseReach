<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Registration Complete — PulseReach</title><link rel="stylesheet" href="/css/app.css?v=8"></head><body class="register-page"><main class="register-shell"><div class="register-brand"><span class="brand-mark">♥</span> PulseReach</div><div class="register-card success-card"><div class="success-icon">✓</div><div class="eyebrow">REGISTRATION COMPLETE</div><h1>You’re registered.</h1><p class="lead"><%= drive.name %><br><%= new Date(drive.date).toLocaleString('en-IN') %> · <%= drive.venue %></p><div class="status-card"><span>Your registration code</span><strong><%= participant.registrationCode %></strong><span>Confirmation</span><strong><%= participant.confirmationStatus %></strong></div><p>Save your registration code. You can use the link below to update your participation status later.</p><a class="btn btn-primary full-btn" href="/registration/<%= participant.registrationCode %>">View registration status</a><small>Communication will only be sent according to the consent choices you made.</small></div></main></body></html>
