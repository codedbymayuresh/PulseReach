<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Registration <%= participant.registrationCode %> — PulseReach</title><link rel="stylesheet" href="/css/app.css?v=8"></head><body class="register-page"><main class="register-shell"><div class="register-brand"><span class="brand-mark">♥</span> PulseReach</div><div class="register-card"><div class="eyebrow">REGISTRATION CONFIRMATION</div><h1><%= participant.name %></h1><p class="lead"><%= drive.name %><br><%= new Date(drive.date).toLocaleString('en-IN') %> · <%= drive.venue %></p><div class="status-card"><span>Registration code</span><strong><%= participant.registrationCode %></strong><span>Current status</span><strong><%= participant.confirmationStatus %></strong><span>Attendance likelihood</span><strong><%= participant.predictedAttendance %>%</strong></div><div class="confirm-actions"><a class="btn btn-ghost full-btn" href="/donor/<%= participant.registrationCode %>">View my donor profile & donation history</a><form method="post" action="/registration/<%= participant.registrationCode %>/confirmation"><input type="hidden" name="status" value="Confirmed"><button class="btn btn-primary full-btn">Confirm participation</button></form><form method="post" action="/registration/<%= participant.registrationCode %>/confirmation"><input type="hidden" name="status" value="Declined"><button class="btn btn-ghost full-btn">I can't attend</button></form></div><p class="muted">You can update your participation status here. Medical eligibility and screening are handled by authorised professionals.</p></div></main><script src="/js/pulsereach-assistant.js?v=1"></script></body></html>
