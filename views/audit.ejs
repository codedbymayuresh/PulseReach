<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Audit Trail — PulseReach</title><link rel="stylesheet" href="/css/app.css?v=11"></head><body class="app"><aside class="sidebar"><a class="brand" href="/dashboard"><span class="brand-mark">♥</span> PulseReach</a><div class="org"><div class="avatar"><%= organizer.name.slice(0,2).toUpperCase() %></div><div><b><%= organizer.name %></b><small><%= organizer.organization %></small></div></div><nav class="side-nav"><a href="/dashboard">⌂ Overview</a><a href="/participants">♙ Participants</a><a href="/reminders">✦ Reminders</a><a href="/communications">✉ Communications</a><a href="/volunteers">♙ Volunteers</a><a class="active" href="/audit">◌ Audit trail</a></nav><div class="side-bottom"><form method="post" action="/logout"><button class="side-logout">↪ Sign out</button></form></div></aside><main class="main"><header class="page-head"><div><div class="eyebrow">ACCOUNTABILITY</div><h1>Audit trail</h1><p>Recent operational actions across your organisation.</p></div></header><section class="panel"><div class="drive-table"><div class="table-row table-head"><span>Time</span><span>Actor</span><span>Action</span><span>Entity</span><span>Details</span></div><% logs.forEach(log=>{ %><div class="table-row" style="grid-template-columns:1.2fr 1fr 1.3fr 1fr 2fr"><span><%= new Date(log.createdAt).toLocaleString('en-IN') %></span><div><b><%= log.actorName %></b><small><%= log.actorRole %></small></div><span><b class="score-pill"><%= log.action %></b></span><span><%= log.entityType %> <%= log.entityId ? '#'+String(log.entityId).slice(-6) : '' %></span><small><%= JSON.stringify(log.details || {}) %></small></div><% }) %><% if (!logs.length) { %><div class="empty-state"><b>No audit events yet.</b><p>Registration, confirmation, attendance and mobilisation actions will appear here.</p></div><% } %></div></section></main><script src="/js/pulsereach-assistant.js?v=1"></script></body></html>
