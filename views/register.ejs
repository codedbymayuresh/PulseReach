<!doctype html>
<html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Register for Drive — <%= drive.name %></title><link rel="stylesheet" href="/css/app.css?v=23"></head>
<body class="auth-page donor-auth"><main class="auth-layout auth-layout-tall">
<section class="auth-image-panel"><img src="/images/pulsereach-donation-hero.jpg" alt="Blood donation camp"><div class="auth-image-shade"></div><a class="auth-image-brand" href="/donor/dashboard"><span class="brand-mark"><img src="/images/pulsereach-logo.png" alt="PulseReach logo"></span> PulseReach</a><div class="auth-image-kicker">DRIVE REGISTRATION</div></section>
<section class="auth-content"><div class="auth-card-refresh"><div class="eyebrow">DRIVE REGISTRATION</div><h1><%= drive.name %></h1><p class="lead"><%= new Date(drive.date).toLocaleString('en-IN',{day:'2-digit',month:'long',year:'numeric',hour:'2-digit',minute:'2-digit'}) %> · <%= drive.venue %></p><% if(drive.description){ %><p><%= drive.description %></p><% } %><% if (error) { %><div class="form-error"><%= error %></div><% } %><div class="info-note"><b>Register as <%= donor?.name || 'Donor' %></b><span>Your donor account details will be used for this registration. Creating an account and registering for a drive are separate actions.</span></div><form method="post" action="/register/<%= drive._id %>"><div class="consent-box"><b>Communication preferences for this drive</b><label class="check"><input type="checkbox" name="communicationConsent" checked><span>I consent to reminders and updates related to this blood donation drive.</span></label><label class="check"><input type="checkbox" name="futureDriveConsent" <%= donor?.futureDriveConsent ? 'checked' : '' %>><span>I also consent to communication about future blood donation drives.</span></label></div><button class="btn btn-primary full-btn">Confirm drive registration →</button></form><div class="auth-bottom"><a class="text-link" href="/donor/dashboard">← Back to donor dashboard</a></div><small>PulseReach uses the gender-based 90/120-day window only to pause future-drive notifications after a recorded donation. Medical eligibility and screening are always determined by authorised professionals.</small></div></section>
</main><script src="/js/pulsereach-assistant.js?v=1"></script></body></html>
