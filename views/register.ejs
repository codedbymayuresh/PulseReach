<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Register — <%= drive.name %></title><link rel="stylesheet" href="/css/app.css?v=8"></head><body class="register-page"><main class="register-shell"><div class="register-brand"><span class="brand-mark">♥</span> PulseReach</div><div class="register-card"><div class="eyebrow">DONOR REGISTRATION</div><h1><%= drive.name %></h1><p class="lead"><%= new Date(drive.date).toLocaleString('en-IN',{day:'2-digit',month:'long',year:'numeric',hour:'2-digit',minute:'2-digit'}) %> · <%= drive.venue %></p><% if(drive.description){ %><p><%= drive.description %></p><% } %><% if (error) { %><div class="form-error"><%= error %></div><% } %><form method="post" action="/register/<%= drive._id %>"><label>Full name<input name="name" required placeholder="Your name"></label><label>Mobile number<input name="phone" required placeholder="10-digit mobile number"></label><label>Email <span>optional</span><input type="email" name="email" placeholder="you@example.com"></label><label>Preferred language<select name="preferredLanguage"><option>English</option><option>Hindi</option><option>Marathi</option></select></label><div class="consent-box"><b>Communication preferences</b><label class="check"><input type="checkbox" name="communicationConsent" checked><span>I consent to reminders and updates related to this blood donation drive.</span></label><label class="check"><input type="checkbox" name="futureDriveConsent"><span>I also consent to communication about future blood donation drives.</span></label></div><button class="btn btn-primary full-btn">Register for the drive →</button></form><small>Registration is for mobilisation and coordination. Medical screening and eligibility are handled by authorised professionals.</small></div></main></body></html>
