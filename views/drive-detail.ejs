<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= drive.name %> — PulseReach</title><link rel="stylesheet" href="/css/app.css"></head><body class="simple-app"><main class="form-shell"><a class="brand" href="/dashboard"><span class="brand-mark">♥</span> PulseReach</a><div class="form-head"><div class="eyebrow">DRIVE CREATED</div><h1><%= drive.name %></h1><p><%= drive.venue %> · <%= new Date(drive.date).toLocaleString('en-IN') %></p></div><div class="panel" style="text-align:center"><img src="<%= qr %>" style="width:190px;height:190px"><h3>Scan to register</h3><p style="color:#667085;word-break:break-all"><%= url %></p><a class="btn btn-primary" href="/register/<%= drive._id %>">Open registration page</a> <a class="btn btn-ghost" href="/dashboard">Dashboard</a></div><div class="panel"><h2><%= participantCount %> registrations</h2><p style="color:#667085">The drive is ready for the first prototype commit. Participant intelligence, reminders, consent and attendance are stored as separate concepts.</p></div></main></body></html>
