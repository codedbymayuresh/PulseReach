<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Create organiser account — PulseReach</title><link rel="stylesheet" href="/css/app.css?v=8"></head><body class="register-page"><main class="register-shell"><a class="register-brand" href="/"><span class="brand-mark">♥</span> PulseReach</a><section class="register-card"><div class="eyebrow">ORGANISER REGISTRATION</div><h1>Create your workspace.</h1><p class="lead">Register an organiser account. Your drives will only be visible inside your authenticated workspace.</p><% if (error) { %><div class="form-error"><%= error %></div><% } %><form method="post" action="/register-organizer"><label>Full name<input name="name" autocomplete="name" required placeholder="Mayuresh Wankhede"></label><label>Organisation / institution<input name="organization" required placeholder="GCOEA"></label><label>Email address<input type="email" name="email" autocomplete="email" required placeholder="you@example.com"></label><div class="form-grid"><label>Password<input type="password" name="password" autocomplete="new-password" minlength="8" required placeholder="At least 8 characters"></label><label>Confirm password<input type="password" name="confirmPassword" autocomplete="new-password" minlength="8" required placeholder="Repeat password"></label></div><div class="form-note">PulseReach stores a secure password hash, not your raw password. This prototype uses session-based authentication for organiser access.</div><button class="btn btn-primary full-btn">Create organiser account →</button></form><small>Already registered? <a class="text-link" href="/login">Sign in</a></small></section></main></body></html>
