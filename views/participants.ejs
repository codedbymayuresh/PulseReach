<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Participants — PulseReach</title><link rel="stylesheet" href="/css/app.css?v=8"></head><body class="app"><aside class="sidebar"><a class="brand" href="/dashboard"><span class="brand-mark">♥</span> PulseReach</a><div class="org"><div class="avatar"><%= organizer.name.slice(0,2).toUpperCase() %></div><div><b><%= organizer.name %></b><small><%= organizer.organization %></small></div></div><nav class="side-nav"><a href="/dashboard">⌂ Overview</a><a class="active" href="/participants">♙ Participants</a><a href="/dashboard#communication">✉ Communications</a><a href="/dashboard#attendance">✓ Attendance</a></nav><div class="side-bottom"><form method="post" action="/logout"><button class="side-logout">↪ Sign out</button></form></div></aside><main class="main"><header class="page-head"><div><div class="eyebrow">PARTICIPANT MANAGEMENT</div><h1>Registration & attendance</h1><p>Manage confirmation, consent and event-day attendance without collecting medical data.</p></div><a class="btn btn-primary" href="/drives/new">＋ Create drive</a></header><section class="stats"><div><span>Registrations</span><strong><%= stats.total %></strong></div><div><span>Confirmed</span><strong><%= stats.confirmed %></strong></div><div><span>Predicted attendance</span><strong><%= stats.predicted %></strong></div><div><span>Actual attendance</span><strong><%= stats.attended %></strong></div></section><section class="panel"><div class="panel-head"><div><h2>All participants</h2><p>Each row is tied to an organiser-owned drive.</p></div></div><div class="participant-table"><div class="table-row table-head"><span>Participant</span><span>Drive</span><span>Prediction</span><span>Confirmation</span><span>Consent</span><span>Attendance</span></div><% if (!participants.length) { %><div class="empty-state"><b>No participants yet.</b><p>Share a drive registration link or QR code.</p></div><% } %><% participants.forEach(p=>{ %><div class="table-row participant-row"><div><b><%= p.name %></b><small><%= p.phone %> · <%= p.preferredLanguage %></small></div><span><%= p.driveId && p.driveId.name ? p.driveId.name : (drives.find(d => String(d._id) === String(p.driveId))?.name || 'Drive') %></span><span><b class="score-pill"><%= p.predictedAttendance %>%</b></span><div class="actions"><form method="post" action="/participants/<%= p._id %>/confirm"><select name="status" onchange="this.form.submit()"><option <%= p.confirmationStatus==='Confirmed'?'selected':'' %>>Confirmed</option><option <%= p.confirmationStatus==='Pending'?'selected':'' %>>Pending</option><option <%= p.confirmationStatus==='Declined'?'selected':'' %>>Declined</option></select></form></div><form method="post" action="/participants/<%= p._id %>/consent" class="consent-mini"><label><input type="checkbox" name="communicationConsent" <%= p.communicationConsent?'checked':'' %>> Drive</label><label><input type="checkbox" name="futureDriveConsent" <%= p.futureDriveConsent?'checked':'' %>> Future</label><button class="tiny-btn">Save</button></form><div class="actions"><form method="post" action="/participants/<%= p._id %>/attendance"><select name="status" onchange="this.form.submit()"><option <%= p.attendanceStatus==='Not Marked'?'selected':'' %>>Not Marked</option><option <%= p.attendanceStatus==='Attended'?'selected':'' %>>Attended</option><option <%= p.attendanceStatus==='Absent'?'selected':'' %>>Absent</option></select></form></div></div><% }) %></div></section></main></body></html>
