<!doctype html>
<html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Create Donor Account — PulseReach</title><link rel="stylesheet" href="/css/app.css?v=22"></head>
<body class="register-page"><main class="register-shell"><a class="register-brand" href="/"><span class="brand-mark">♥</span> PulseReach</a><div class="register-card">
<div class="eyebrow">DONOR PORTAL</div><h1>Create your donor account.</h1><p class="lead">Create your account once, then choose the blood donation drives you want to register for from your dashboard.</p>
<% if (error) { %><div class="form-error"><%= error %></div><% } %>
<form method="post" action="/donor/register">
<label>Full name<input name="name" value="<%= form?.name || '' %>" required placeholder="Your name"></label>
<label>Mobile number<input name="phone" value="<%= form?.phone || '' %>" required inputmode="numeric" placeholder="10-digit mobile number"></label>
<div class="form-grid"><label>Gender<select name="gender" required><option value="">Select gender</option><option <%= form?.gender === 'Male' ? 'selected' : '' %>>Male</option><option <%= form?.gender === 'Female' ? 'selected' : '' %>>Female</option><option <%= form?.gender === 'Other' ? 'selected' : '' %>>Other</option></select></label><label>Blood group<select name="bloodGroup" required><option value="">Select blood group</option><% ['A+','A-','B+','B-','AB+','AB-','O+','O-'].forEach(bg => { %><option <%= form?.bloodGroup === bg ? 'selected' : '' %>><%= bg %></option><% }) %></select></label></div>
<label>Email <span>optional</span><input type="email" name="email" value="<%= form?.email || '' %>" placeholder="you@example.com"></label>
<label>Preferred language<select name="preferredLanguage"><% ['English','Hindi','Marathi'].forEach(lang => { %><option <%= (form?.preferredLanguage || 'English') === lang ? 'selected' : '' %>><%= lang %></option><% }) %></select></label>
<div class="form-grid"><label>Account password<input type="password" name="password" required minlength="8" placeholder="At least 8 characters"></label><label>Confirm password<input type="password" name="confirmPassword" required minlength="8" placeholder="Re-enter password"></label></div>
<div class="consent-box"><b>Communication preferences</b><label class="check"><input type="checkbox" name="communicationConsent" checked><span>I consent to reminders and updates for drives I register for.</span></label><label class="check"><input type="checkbox" name="futureDriveConsent"><span>I also consent to communication about future blood donation drives.</span></label></div>
<button class="btn btn-primary full-btn">Create donor account →</button>
</form>
<div class="info-note"><b>No automatic drive registration</b><span>Creating this account does not register you for any blood donation drive. You will choose and register for drives separately from your dashboard.</span></div>
<small>PulseReach handles donor mobilisation and communication. Medical eligibility and screening are always determined by authorised professionals.</small>
<div style="margin-top:18px;text-align:center">Already have an account? <a class="text-link" href="/donor/login">Donor Login</a></div>
</div></main><script src="/js/pulsereach-assistant.js?v=1"></script></body></html>
