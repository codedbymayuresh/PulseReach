<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Donor Profile — PulseReach</title><link rel="stylesheet" href="/css/app.css?v=14"></head><body class="register-page"><main class="register-shell donor-shell"><div class="register-brand"><span class="brand-mark">♥</span> PulseReach</div><div class="register-card donor-card"><div class="eyebrow">DONOR PROFILE</div><h1><%= donor.name %></h1><p class="lead"><%= donor.bloodGroup %> blood group · <%= donor.gender %> · <%= donor.phone %></p><div class="donor-summary"><div><span>Donations recorded</span><strong><%= donations.length %></strong></div><div><span>Last donation</span><strong><%= donor.lastDonationDate ? new Date(donor.lastDonationDate).toLocaleDateString('en-IN') : 'Not recorded' %></strong></div><div><span>Notifications</span><strong><%= donor.notificationPausedUntil && new Date(donor.notificationPausedUntil) > new Date() ? 'Paused' : 'Active' %></strong></div></div><% if (donor.notificationPausedUntil && new Date(donor.notificationPausedUntil) > new Date()) { %><div class="info-note"><b>Future-drive notifications are paused</b><span>PulseReach will resume notifications after <%= new Date(donor.notificationPausedUntil).toLocaleDateString('en-IN') %>. This is a communication setting, not a medical eligibility decision.</span></div><% } %><section class="donation-history"><div class="section-head"><div><div class="eyebrow">HISTORY</div><h2>Previous donations</h2></div></div><% if (!donations.length) { %><div class="empty-state"><b>No donation records yet.</b><p>Your e-certificates will appear here after an organiser records a completed donation.</p></div><% } else { %><div class="history-list"><% donations.forEach(d => { %><article class="history-item"><div><b><%= new Date(d.donationDate).toLocaleDateString('en-IN',{day:'2-digit',month:'short',year:'numeric'}) %></b><span><%= d.location %></span></div><a class="btn btn-ghost" href="/certificates/<%= d.certificateCode %>" target="_blank">View e-certificate ↗</a></article><% }) %></div><% } %></section><p class="muted">Medical eligibility, screening and donation decisions are handled by authorised professionals.</p></div></main><script src="/js/pulsereach-assistant.js?v=1"></script></body></html>
